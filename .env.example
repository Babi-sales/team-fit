# Used by docker-compose.yml for the full self-hosted stack (db + backend +
# frontend + Caddy reverse proxy). Copy to `.env` on the VPS and fill in real
# values — never commit the real `.env`.

# Your domain, pointed at the VPS via DNS (A record). Caddy gets HTTPS for it
# automatically via Let's Encrypt. For local testing, `localhost` works too
# (Caddy serves plain HTTP for it, no ACME).
DOMAIN=teamfit.yourdomain.com

# Postgres password (any strong random string).
POSTGRES_PASSWORD=change-me

# Shared PIN that gates the whole app.
APP_PIN=change-me

# Used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-too
