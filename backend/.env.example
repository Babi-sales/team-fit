# Supabase — Project Settings > Database > Connection string (modo "Transaction" ou "Session", com asyncpg)
# Formato: postgresql+asyncpg://postgres:[SUA-SENHA]@[HOST]:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# Obrigatório sempre — usado para assinar/verificar os tokens de login.
# Em produção: Supabase Project Settings > API > JWT Settings > JWT Secret.
# Em modo local: qualquer string secreta serve (ex: local-dev-secret-change-me).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Só necessários em produção (convite de usuários por e-mail via Supabase Auth).
# Deixe em branco em modo local.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# true = login local sem Supabase (tela /login pede só nome + e-mail).
# NUNCA deixe true em produção.
LOCAL_AUTH_ENABLED=false

# Gemini (agentes de IA) — chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# Resend (e-mail de boas-vindas) — opcional. Sem isso, o e-mail é só pulado (log).
# Convite e reset de senha NÃO usam essa chave — em produção, configure o Resend
# como SMTP no painel do Supabase (Authentication > Emails > SMTP Settings).
# Chave em https://resend.com/api-keys — precisa de domínio verificado no Resend
# para o remetente abaixo funcionar de verdade (fora do domínio de teste resend.dev).
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Team Fit <onboarding@resend.dev>

# CORS — URL do frontend em produção (Vercel) e local
FRONTEND_ORIGINS=http://localhost:3000,https://your-app.vercel.app
