# Postgres connection string (self-hosted, e.g. the `db` service in docker-compose.yml).
# Format: postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+asyncpg://teamfit:password@localhost:5432/teamfit

# Shared PIN that gates the whole app — anyone with this PIN can see/edit both
# people's data. Pick something only you and your household know.
APP_PIN=change-me

# Used to sign the session cookie issued after a correct PIN. Any long random
# string works — e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-too

# Frontend origin(s) allowed to call this API (comma-separated). Local dev +
# your production domain.
FRONTEND_ORIGINS=http://localhost:3000
